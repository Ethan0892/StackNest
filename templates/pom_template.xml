<?xml version="1.0" encoding="UTF-8"?>
<!--
  templates/pom_template.xml
  Maven project template for generated Paper plugins.
  Placeholder tokens (${PLUGIN_NAME}, ${PLUGIN_GROUP_ID}) are filled
  programmatically by the API when packaging a download.

  This file is kept up-to-date automatically by api/paper_versions.py.
  Paper API version and Java release are patched on every weekly refresh.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>${PLUGIN_GROUP_ID}</groupId>
  <artifactId>${PLUGIN_ARTIFACT_ID}</artifactId>
  <version>${PLUGIN_VERSION}</version>
  <packaging>jar</packaging>

  <name>${PLUGIN_NAME}</name>
  <description>Generated by StackNest — https://stacknests.com</description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- ──────────────────────────────────────────────────────────── -->
  <!-- Repositories                                                   -->
  <!-- ──────────────────────────────────────────────────────────── -->
  <repositories>

    <!-- Paper API (required) -->
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>

    <!-- Vault (economy / permissions) — only needed if using Vault API -->
    <repository>
      <id>jitpack</id>
      <url>https://jitpack.io</url>
    </repository>

    <!-- MockBukkit -->
    <repository>
      <id>mockbukkit-repo</id>
      <url>https://repo.mockbukkit.org/releases</url>
    </repository>

    <!-- PlaceholderAPI -->
    <repository>
      <id>placeholderapi</id>
      <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
    </repository>

  </repositories>

  <!-- ──────────────────────────────────────────────────────────── -->
  <!-- Dependencies                                                   -->
  <!-- ──────────────────────────────────────────────────────────── -->
  <dependencies>

    <!-- Paper API — always provided (server ships it) -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>26.1.2.build.62-stable</version>
      <scope>provided</scope>
    </dependency>

    <!--
    Brigadier — Paper's command framework.  The server ships it, but you need
    it on the compile classpath when importing com.mojang.brigadier.* directly.
    Only needed when using the Lifecycle/Brigadier command API; remove if using
    plugin.yml + getCommand() for commands instead.
    -->
    <dependency>
      <groupId>com.mojang</groupId>
      <artifactId>brigadier</artifactId>
      <version>1.3.10</version>
      <scope>provided</scope>
    </dependency>

    <!--
    Vault API — uncomment if plugin uses economy/permissions via Vault

    <dependency>
      <groupId>com.github.MilkBowl</groupId>
      <artifactId>VaultAPI</artifactId>
      <version>1.7.1</version>
      <scope>provided</scope>
    </dependency>
    -->

    <!--
    PlaceholderAPI — uncomment if plugin registers/uses placeholders

    <dependency>
      <groupId>me.clip</groupId>
      <artifactId>placeholderapi</artifactId>
      <version>2.11.6</version>
      <scope>provided</scope>
    </dependency>
    -->

    <!--
    HikariCP — uncomment if plugin uses connection pooling for SQL

    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>5.1.0</version>
      <scope>compile</scope>
    </dependency>
    -->

    <!-- ── Testing ──────────────────────────────────────────────────────── -->

    <!-- JUnit 5 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>

    <!-- MockBukkit — in-process Paper server mock for unit tests -->
    <!--
    Update the artifactId to match your Paper version, e.g. MockBukkit-v26.1.
    Check https://github.com/MockBukkit/MockBukkit/releases for the latest.
    <dependency>
      <groupId>com.github.seeseemelk</groupId>
      <artifactId>MockBukkit-v26.1</artifactId>
      <version>LATEST</version>
      <scope>test</scope>
    </dependency>
    -->

  </dependencies>

  <!-- ──────────────────────────────────────────────────────────── -->
  <!-- Build                                                          -->
  <!-- ──────────────────────────────────────────────────────────── -->
  <build>
    <defaultGoal>clean package</defaultGoal>
    <finalName>${PLUGIN_NAME}-${PLUGIN_VERSION}</finalName>

    <resources>
      <!-- Include plugin.yml and config.yml in the JAR -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>

    <plugins>

      <!-- Surefire — run JUnit 5 tests with mvn test -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>

      <!-- Compiler -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- Single <release> flag is recommended over separate source+target -->
          <release>${maven.compiler.release}</release>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>

      <!-- Shade — bundles runtime deps (e.g. HikariCP) into the JAR -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <minimizeJar>false</minimizeJar>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

</project>
