# =============================================================================
# deploy/.env.production.example
#
# Copy this to /opt/stacknest/.env on your server and fill it in.
#   cp /opt/stacknest/deploy/.env.production.example /opt/stacknest/.env
#   nano /opt/stacknest/.env
#
# NEVER commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# Server binding (gunicorn listens only on localhost; nginx faces the internet)
# ---------------------------------------------------------------------------
PORT=5000
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Security / Proxy (required when behind nginx)
# ---------------------------------------------------------------------------
TRUST_PROXY=true           # Flask ProxyFix — trust X-Forwarded-For from nginx
FORCE_HSTS=true            # Inject Strict-Transport-Security header
HSTS_MAX_AGE=31536000      # 1 year (seconds)

ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
ADMIN_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN_TTL=3600       # seconds
ADMIN_COOKIE_SECURE=true   # requires HTTPS

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
STACKNEST_DB=data/stacknest.db

# ---------------------------------------------------------------------------
# Local llama.cpp inference (optional — remove if not running llama-server)
# ---------------------------------------------------------------------------
LLAMACPP_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# AI API Keys (use at least one)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-preview-05-20
GEMINI_MAX_TOKENS=8192

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-4-5

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_GEN_MODEL=moonshot-v1-32k
KIMI_VALIDATE_MODEL=moonshot-v1-8k

# ---------------------------------------------------------------------------
# Stripe (leave blank to disable payments / PAYG credits)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PAYG_PRICE_ID=price_...

# ---------------------------------------------------------------------------
# Email / SMTP (for password reset, notifications)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=
SMTP_FROM=StackNest <noreply@yourdomain.com>
APP_BASE_URL=https://yourdomain.com

# ---------------------------------------------------------------------------
# Log analysis limits
# ---------------------------------------------------------------------------
LOG_ANALYSIS_MAX_CHARS=50000
LOG_ANALYSIS_MAX_ISSUES=20

# ---------------------------------------------------------------------------
# Request limits
# ---------------------------------------------------------------------------
MAX_REQUEST_BYTES=10485760     # 10 MB (nginx already limits to 8 MB)

# ---------------------------------------------------------------------------
# PRO API keys (comma-separated; leave blank if not using key-based pro access)
# ---------------------------------------------------------------------------
PRO_API_KEYS=

# ---------------------------------------------------------------------------
# Per-user plan grants (override plan for specific email addresses)
# Format: email1:plan1,email2:plan2
# ---------------------------------------------------------------------------
RESERVED_EMAIL_PLANS=

# ---------------------------------------------------------------------------
# Discord bot (only needed if running discord_bot/bot.py)
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=
DISCORD_RULES_CHANNEL=
DISCORD_WELCOME_CHANNEL=
DISCORD_VERIFIED_ROLE_ID=
DISCORD_ROLE_PICKER_CHANNEL=
DISCORD_ROLE_GIVEAWAY=
DISCORD_ROLE_UPDATES=
DISCORD_ROLE_ANNOUNCEMENTS=
DISCORD_TICKETS_CHANNEL=
DISCORD_TICKET_CATEGORY=
DISCORD_STAFF_ROLE_ID=
DISCORD_LINKED_ROLE_ID=
DISCORD_GIVEAWAY_CHANNEL=
