# LLAMACPP_URL=http://localhost:8080
# CHROMADB_PATH=data/embeddings/chromadb
# PORT=5000
# HOST=0.0.0.0
#
# ── Production security baseline ────────────────────────────────────────────
# Maximum accepted HTTP request payload size (bytes)
# MAX_REQUEST_BYTES=1048576
#
# Restrict allowed Host header values (comma-separated). Leave empty to disable.
# Example: ALLOWED_HOSTS=stacknest.dev,api.stacknest.dev
# ALLOWED_HOSTS=
#
# Restrict CORS origins for /api/* (comma-separated).
# Example: CORS_ALLOWED_ORIGINS=https://stacknest.dev,https://app.stacknest.dev
# CORS_ALLOWED_ORIGINS=*
#
# Enable when running behind reverse proxy (nginx/caddy/cloudflare) so Flask
# correctly reads X-Forwarded-* headers.
# TRUST_PROXY=false
#
# Enforce HSTS (HTTPS strict transport). Keep false in local HTTP dev.
# FORCE_HSTS=false
# HSTS_MAX_AGE=31536000
#
# Content-Security-Policy header (override only if needed)
# SECURITY_CSP=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'

# Pro API keys — comma-separated, no spaces
# PRO_API_KEYS=key1,key2,key3

# ── Admin panel ───────────────────────────────────────────────────────────────
# Set ADMIN_SECRET to enable the admin panel at /admin.
# Use a long, random string — keep this private.
# ADMIN_SECRET=change-me-to-a-long-random-secret
#
# Session token TTL in seconds (default: 3600 = 1 hour)
# ADMIN_TOKEN_TTL=3600
#
# Set true in production HTTPS environments so admin cookie is only sent via TLS.
# ADMIN_COOKIE_SECURE=true
# Admin cookie SameSite policy: Strict / Lax / None
# ADMIN_COOKIE_SAMESITE=Strict
#
# Path to the SQLite database used for request logging and IP management
# STACKNEST_DB=data/stacknest.db

# ── Kimi (Moonshot AI) — validation + healing backend (not for generation)
#   - Deep code validation (Kimi K2.5)
#   - Context-Aware Healing (auto-fix build errors)
#   - Server log AI analysis
# Get your key at: https://platform.moonshot.cn/
# KIMI_API_KEY=sk-...
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_GEN_MODEL=moonshot-v1-32k
# KIMI_VALIDATE_MODEL=kimi-k2-0711-preview

# ── Google Gemini — FREE-tier generation fallback ─────────────────────────
# Used when the local fine-tuned model is unavailable.
# Free quota: 1 500 req/day on gemini-2.0-flash (sufficient for community usage).
# Get a free key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSyBguHxVfwqF2sICnoF6pV8sckp4_VDEVmc
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MAX_TOKENS=8192

# ── Anthropic Claude — PREMIUM-tier generation backend ────────────────────
# Only used for users with a pro API key (X-API-Key header or DB plan=premium).
# Free users fall back to Gemini; premium users use Claude for highest quality.
# Get key at: https://console.anthropic.com/ (~$5 free credits on signup)
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-3-5-haiku-20241022   # fast + affordable for premium tier

# ── SMTP email (account verification + password reset) ────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM=noreply@stacknest.app
# APP_BASE_URL=https://stacknest.app

# ── Log analyzer tuning ─────────────────────────────────────────────────────
# Maximum accepted log payload size for /api/logs/analyze
# LOG_ANALYSIS_MAX_CHARS=200000
#
# Maximum number of issue objects returned to the frontend
# LOG_ANALYSIS_MAX_ISSUES=120

# ── Discord bot ──────────────────────────────────────────────────────────────
# Token from https://discord.com/developers/applications → Bot → Reset Token
# DISCORD_BOT_TOKEN=your-discord-bot-token-here